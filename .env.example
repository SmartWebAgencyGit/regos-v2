APP_NAME="Player Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The portal keeps no data of its own; SQLite is only here for Laravel defaults.
DB_CONNECTION=sqlite

# Visitors stay signed in (like the old localStorage key) for 30 days.
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- HAPI (Xena booking API) ---------------------------------------------
# HAPI_FAKE=true serves built-in demo bookings (local only).
# Print demo sign-in links with: php artisan regos:demo-links
HAPI_FAKE=true
HAPI_URL=http://129.232.225.76/api
HAPI_USERNAME=
HAPI_PASSWORD=
HAPI_SYSTEM=alpha

# Comma-separated proxy IPs allowed to set X-Forwarded-For (blank = none).
TRUSTED_PROXIES=

# --- Payments ---------------------------------------------------------------
# "fake" approves every card except 4000 0000 0000 0002 (local only).
REGOS_PAYMENT_DRIVER=fake
WORLDPAY_URL=https://secure.worldpay.com/jsp/merchant/xml/paymentService.jsp
WORLDPAY_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
